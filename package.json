{
  "name": "iyal-physics-app",
  "version": "0.1.0",
  "private": true,
  "description": "Tamil-first Sri Lankan A/L physics learning prototype",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "test": "vitest run",
    "format": "prettier --write src tests index.html tsconfig.json vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src tests index.html tsconfig.json vite.config.ts vitest.config.ts",
    "export:content": "node scripts/export-content.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
